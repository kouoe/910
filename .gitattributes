# Normalize line endings to LF inside the repository.
# *.py / *.java / *.yml are LF-only (fixes the "LF will be replaced by CRLF" warning).
* text=auto eol=lf

# Windows scripts keep CRLF so they can run on cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be diffed or converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.docx binary
*.pdf binary
